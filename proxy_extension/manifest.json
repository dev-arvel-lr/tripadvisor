{
  "manifest_version": 3,
  "name": "Proxy Authentication Extension",
  "version": "1.0",
  "description": "Chrome extension to handle proxy authentication.",
  "permissions": ["proxy", "storage", "webRequest", "webRequestAuthProvider"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  }
}
